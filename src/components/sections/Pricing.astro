---
import { MessageSquare, ArrowRight, Compass, Layers, CheckCircle2 } from 'lucide-react';

const scopeSteps = [
  {
    icon: Compass,
    title: "1. Understand & Discover",
    description: "Deep dive into your business workflow, operational bottlenecks, user personas and project goals.",
    glow: "rgba(129, 140, 248, 0.15)",
    iconColor: "text-indigo-400",
    gradient: "from-indigo-400 to-indigo-600",
  },
  {
    icon: Layers,
    title: "2. Technical Architecture",
    description: "Designing the right system model, technology stack, database structure and integration plan.",
    glow: "rgba(52, 211, 153, 0.15)",
    iconColor: "text-emerald-400",
    gradient: "from-emerald-400 to-emerald-600",
  },
  {
    icon: CheckCircle2,
    title: "3. Scope & Estimation",
    description: "A clear engineering proposal with transparent deliverables, realistic milestones and budget options.",
    glow: "rgba(167, 139, 250, 0.15)",
    iconColor: "text-violet-400",
    gradient: "from-violet-400 to-violet-600",
  },
];
---

<section id="scope" class="py-24 md:py-32 relative z-10 overflow-hidden" style="background-color: var(--color-bg);">
  {/* Background gradient accents */}
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-indigo-500/[0.02] to-transparent pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-indigo-500/5 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="w-full max-w-7xl mx-auto px-8 sm:px-10 md:px-14 lg:px-20 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-14 md:mb-16">
      <span class="inline-block text-indigo-400 font-heading font-semibold tracking-wider uppercase text-xs md:text-sm mb-3" style="font-family: Space Grotesk, sans-serif">
        Let's scope your project
      </span>
      <h2 class="text-3xl md:text-5xl font-bold mb-5 tracking-tight font-heading" style="color: var(--color-text-primary); font-family: Space Grotesk, sans-serif">
        Let's scope your <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">project</span>
      </h2>
      <p class="text-base md:text-lg leading-relaxed max-w-2xl mx-auto" style="color: var(--color-text-secondary)">
        Every business has different requirements. I prefer to understand your goals, workflows and technical needs before proposing the right solution.
      </p>
    </div>

    {/* Scoping Pillars / Process Cards with What We Build Glow Effect */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-12">
      {scopeSteps.map((step, index) => (
        <div 
          class="scope-card group relative p-6 md:p-8 rounded-2xl text-left transition-all duration-500 hover:-translate-y-2 hover:shadow-xl cursor-default overflow-hidden flex flex-col justify-between"
          style={`background: var(--color-surface); border: 1px solid var(--color-border);`}
          data-glow={step.glow}
        >
          {/* Top gradient highlight on hover */}
          <div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${step.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>
          
          {/* Card index indicator */}
          <span class="absolute top-4 right-5 text-[10px] font-bold tracking-[0.2em] opacity-0 group-hover:opacity-40 transition-opacity duration-300" style="color: var(--color-text-primary); font-family: Space Grotesk, sans-serif">
            {String(index + 1).padStart(2, '0')}
          </span>

          <div class="relative z-10">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-500" style={`background: ${step.glow};`}>
              <step.icon size={24} class={step.iconColor} />
            </div>
            <h3 class="text-lg font-bold mb-2.5 transition-colors duration-300" style="color: var(--color-text-primary); font-family: Space Grotesk, sans-serif">
              {step.title}
            </h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary)">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    {/* Primary CTA */}
    <div class="text-center">
      <a 
        href="#contact" 
        class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-primary hover:bg-primary-600 text-white font-bold font-heading rounded-xl transition-all duration-300 hover:scale-105 shadow-glow-primary hover:shadow-[0_0_35px_rgba(129,140,248,0.5)]"
      >
        <MessageSquare size={18} />
        <span>Request a consultation</span>
        <ArrowRight size={16} />
      </a>
    </div>

  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.scope-card').forEach((card: any) => {
      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });
  });
</script>
