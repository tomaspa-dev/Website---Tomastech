---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	keywords?: string;
	ogType?: string;
	schema?: Record<string, any>;
}

const { 
	title, 
	description = "Custom web applications, business software, ERP, automation and AI solutions built around your business processes. Based in Peru, working worldwide.",
	image = "/logo.png",
	keywords = "custom web applications, custom software development, business software, ERP, automation, AI, software engineer, Peru",
	ogType = "website",
	schema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const defaultSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": "https://tomastech.dev/#website",
			"name": "Tomastech",
			"url": "https://tomastech.dev",
			"description": description,
			"inLanguage": "en"
		},
		{
			"@type": "Organization",
			"@id": "https://tomastech.dev/#organization",
			"name": "Tomastech",
			"url": "https://tomastech.dev",
			"logo": "https://tomastech.dev/logo.png",
			"description": "Custom web applications, business software and AI-enabled systems development.",
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "PE"
			},
			"areaServed": "Worldwide",
			"sameAs": [
				"https://github.com/tomaspa-dev",
				"https://www.linkedin.com/company/tomastechdev",
				"https://x.com/tomastechdev",
				"https://www.instagram.com/tomastechdev/"
			]
		},
		{
			"@type": "Person",
			"@id": "https://tomastech.dev/#person",
			"name": "Tomas Eduardo Pozu Asalde",
			"url": "https://tomastech.dev",
			"jobTitle": "Software Engineer",
			"sameAs": [
				"https://github.com/tomaspa-dev",
				"https://www.linkedin.com/company/tomastechdev"
			],
			"knowsAbout": [
				"Software Engineering",
				"Software Architecture",
				"Distributed Systems",
				"Cloud Infrastructure",
				"Business Systems",
				"Full-Stack Development",
				"Application Security",
				"AI-assisted Development"
			]
		}
	]
};

import SettingsSidebar from '../components/ui/SettingsSidebar';
import CustomCursor from '../components/ui/CustomCursor';
import ToastContainer from '../components/ui/ToastContainer';
import { ViewTransitions } from 'astro:transitions';
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Tomas Eduardo Pozu Asalde" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="Tomastech | Software Engineering & Business Systems" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site)} />
		
		<!-- Additional SEO -->
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow" />
		<meta name="theme-color" content="#818cf8" />
		
		<!-- DNS Prefetch for external domains -->
		<link rel="dns-prefetch" href="https://github.com" />
		<link rel="dns-prefetch" href="https://linkedin.com" />
		
		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" set:html={JSON.stringify(schema || defaultSchema)} />
		
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class="bg-background text-text-primary antialiased overflow-x-hidden cursor-none transition-colors duration-400">
		<!-- Noise Overlay -->
		<div class="fixed inset-0 z-[9990] pointer-events-none mix-blend-overlay" style={`opacity: var(--noise-opacity); background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");`}></div>
		
		<CustomCursor client:load />
		<slot />
		<SettingsSidebar client:load />
		<ToastContainer client:load />

		<!-- Theme initialization: prevent flash of wrong theme -->
		<script is:inline>
			(function() {
				const theme = localStorage.getItem('theme');
				if (theme === 'light') {
					document.documentElement.classList.remove('dark');
					document.documentElement.classList.add('light');
				} else {
					document.documentElement.classList.add('dark');
					document.documentElement.classList.remove('light');
				}
			})();
		</script>

		<script>
			import Lenis from 'lenis';
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			gsap.registerPlugin(ScrollTrigger);

			// Don't initialize Lenis on pages with their own scroll containers
			const isDashboard   = window.location.pathname.includes('/dashboard');
			const isClientAccess = window.location.pathname.includes('/client-access');
			const isLogin       = window.location.pathname.includes('/panel-56Up89');
			
			if (!isDashboard && !isClientAccess && !isLogin) {
				const lenis = new Lenis({
					prevent: (node) => node.hasAttribute('data-lenis-prevent') || !!node.closest?.('[data-lenis-prevent]')
				});
				(window as any).__lenis = lenis;

				// ── Connect Lenis → GSAP ScrollTrigger ──────────────────
				// Without this, Lenis intercepts scroll but ScrollTrigger
				// never gets events → opacity:0 elements stay invisible
				lenis.on('scroll', ScrollTrigger.update);
				gsap.ticker.add((time) => lenis.raf(time * 1000));
				gsap.ticker.lagSmoothing(0);

				// ── Refresh after page paint so viewport calculations ─────
				// are correct (fonts + images loaded)
				document.addEventListener('astro:page-load', () => {
					setTimeout(() => ScrollTrigger.refresh(), 250);
				});
			}
		</script>
	</body>
</html>
